# Base URL of the Streetman Cafe & Flames backend API (no trailing slash).
# - Android emulator default: http://10.0.2.2:8000
# - iOS simulator / web default: http://127.0.0.1:8000
# - Physical device via Expo Go: use your machine's LAN IP, e.g. http://192.168.1.20:8000
# - Production: your Railway backend URL, e.g. https://streetman-app.up.railway.app
#
# Set this at build time in production (EAS / Expo web export).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000